<Window x:Class="Parser.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Twitter Parser — тестовый клиент">
  <Grid Padding="28" RowSpacing="18" DataContext="{x:Bind ViewModel}">
    <Grid.Resources>
      <DataTemplate x:Key="PostTemplate">
        <Border Padding="20" Margin="0,0,0,12" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding Caption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="16" />
            <ItemsControl ItemsSource="{Binding Photos}">
              <ItemsControl.ItemTemplate><DataTemplate><Image Source="{Binding}" MaxHeight="360" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,8" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding PhotoError}" TextWrapping="Wrap" />
            <HyperlinkButton NavigateUri="{Binding Url}" Content="Открыть оригинал в X" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="JobLogTemplate">
        <Border Padding="16" Margin="0,0,0,8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Reason}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Caption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock Text="{Binding TextPreview}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <HyperlinkButton NavigateUri="{Binding Url}" Content="Открыть пост в X" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </DataTemplate>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock Text="Twitter Parser" Style="{ThemeResource TitleTextBlockStyle}" />
      <TextBlock Text="Сбор публикаций · текст и журнал заданий · PostgreSQL" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="8">
      <TextBlock Text="{Binding TimeZoneLabel}" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <DatePicker Header="С" SelectedDate="{Binding From, Mode=TwoWay}" />
        <DatePicker Header="По" SelectedDate="{Binding To, Mode=TwoWay}" />
        <ComboBox Header="Сохранённый автор" ItemsSource="{Binding Authors}" DisplayMemberPath="Username" SelectedItem="{Binding SelectedAuthor, Mode=TwoWay}" MinWidth="170" />
        <Button Content="Обновить авторов" Command="{Binding RefreshAuthorsCommand}" VerticalAlignment="Bottom" />
      </StackPanel>
    </StackPanel>
    <TabView Grid.Row="2" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False">
      <TabViewItem Header="Подключение" IsClosable="False">
        <StackPanel Spacing="16" Padding="12,24" MaxWidth="600" HorizontalAlignment="Left">
          <TextBox Header="Адрес сервера" Text="{Binding ServerUrl, Mode=TwoWay}" MinWidth="450" />
          <PasswordBox x:Name="ApiKeyBox" Header="Ключ API (если настроен на сервере)" PasswordChanged="ApiKeyChanged" />
          <Button Content="Проверить подключение" Command="{Binding ConnectCommand}" Style="{ThemeResource AccentButtonStyle}" />
          <TextBlock Text="Для локального сервера: http://localhost:5080. Ключ хранится только в памяти приложения." TextWrapping="Wrap" />
        </StackPanel>
      </TabViewItem>
      <TabViewItem Header="Сбор" IsClosable="False">
        <ScrollViewer><StackPanel Spacing="16" Padding="12,24">
          <TextBox Header="Username автора в X" PlaceholderText="username или @username" Text="{Binding Author, Mode=TwoWay}" MaxWidth="450" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Начать сбор" Command="{Binding StartCommand}" Style="{ThemeResource AccentButtonStyle}" />
            <Button Content="Отменить" Command="{Binding CancelCommand}" />
          </StackPanel>
          <TextBox Header="ID задания — можно вставить после перезапуска клиента" Text="{Binding JobId, Mode=TwoWay}" MaxWidth="500" HorizontalAlignment="Left" />
          <Button Content="Следить за заданием" Command="{Binding TrackCommand}" />
          <TextBlock Text="{Binding JobSummary}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          <TextBlock Text="Сохраняется текст постов от 10 слов, включая ответы, репосты и цитаты. Изображения, видео и GIF не скачиваются. Причины пропусков доступны на вкладке «Лог задания»." TextWrapping="Wrap" />
        </StackPanel></ScrollViewer>
      </TabViewItem>
      <TabViewItem Header="Лог задания" IsClosable="False">
        <Grid Padding="12,24" RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Spacing="8">
            <TextBox Header="ID задания" Text="{Binding JobId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="500" HorizontalAlignment="Left" />
            <TextBlock Text="Лог выбранного задания. Для текущего сбора нажмите «Обновить лог» повторно." TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ComboBox Header="Причина" ItemsSource="{Binding LogReasons}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedLogReason, Mode=TwoWay}" MinWidth="240" />
            <Button Content="Обновить лог" Command="{Binding LoadLogCommand}" VerticalAlignment="Bottom" />
            <Button Content="Назад" Command="{Binding PreviousLogCommand}" VerticalAlignment="Bottom" />
            <Button Content="Далее" Command="{Binding NextLogCommand}" VerticalAlignment="Bottom" />
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="{Binding LogSummary}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock Text="{Binding LogPageSummary}" />
          </StackPanel>
          <ListView Grid.Row="3" ItemsSource="{Binding JobLogs}" ItemTemplate="{StaticResource JobLogTemplate}" SelectionMode="None" HorizontalContentAlignment="Stretch" />
        </Grid>
      </TabViewItem>
      <TabViewItem Header="Сохранённые посты" IsClosable="False">
        <Grid Padding="12,24" RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Загрузить" Command="{Binding LoadCommand}" />
            <Button Content="Назад" Command="{Binding PreviousCommand}" />
            <Button Content="Далее" Command="{Binding NextCommand}" />
            <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" />
          </StackPanel>
          <ListView Grid.Row="1" ItemsSource="{Binding Posts}" ItemTemplate="{StaticResource PostTemplate}" SelectionMode="None" HorizontalContentAlignment="Stretch" />
        </Grid>
      </TabViewItem>
      <TabViewItem Header="Случайный пост" IsClosable="False">
        <Grid Padding="12,24" RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Button Content="Получить случайный пост" Command="{Binding RandomCommand}" Style="{ThemeResource AccentButtonStyle}" />
          <ListView Grid.Row="1" ItemsSource="{Binding RandomPosts}" ItemTemplate="{StaticResource PostTemplate}" SelectionMode="None" HorizontalContentAlignment="Stretch" />
        </Grid>
      </TabViewItem>
    </TabView>
    <TextBlock Grid.Row="3" Text="{Binding Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
  </Grid>
</Window>
