# Copy this file to .env in the solution root, then fill in your local values.
# .env is read automatically by Parser.Api and Docker Compose. Never commit secrets.

# PostgreSQL for compose.yaml (use the same password in the connection string).
POSTGRES_PASSWORD=replace-with-a-local-password
ConnectionStrings__Parser='Host=localhost;Port=15432;Database=twitter_parser;Username=parser;Password=replace-with-a-local-password'

# X session cookies from your signed-in browser. Leave empty to use --login-x storage state.
Parser__AuthToken=
Parser__CsrfToken=

# Browser: set false to see why X cannot load the profile.
Parser__Headless=true
Parser__ScrollDelayMs=2000
Parser__MaxScrolls=100
Parser__MaxJobMinutes=20

# Local API.
Urls=http://localhost:5080
Api__Key=
Api__AllowAnonymousLoopback=true
